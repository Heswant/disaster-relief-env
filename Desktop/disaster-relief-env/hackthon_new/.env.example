# ─────────────────────────────────────────────────────────────
# Disaster Relief Supply Agent — Environment Variables
# Copy this file to .env and fill in values before running.
# ─────────────────────────────────────────────────────────────

# ── Hackathon-required variables (inference.py) ──────────────
# LLM API endpoint (HuggingFace router or any OpenAI-compatible URL)
API_BASE_URL=https://router.huggingface.co/v1

# Model identifier to use for inference
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# HuggingFace token for API authentication (required for inference.py)
HF_TOKEN=

# ── Server / environment config ───────────────────────────────
# Disaster scenario to load
# Options: flood | earthquake
SCENARIO=flood

# Enable browser-based web interface for interactive debugging
# Access at: http://localhost:8000/web
ENABLE_WEB_INTERFACE=true

# Random seed for reproducible episodes
RNG_SEED=42

# Enable LLM-based reasoning quality scoring
# Requires OPENAI_API_KEY to be set
USE_LLM=false

# OpenAI API key (required only when USE_LLM=true)
OPENAI_API_KEY=
