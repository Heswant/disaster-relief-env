# External facade
PORT=8787
CONTROL_TOWER_INTERNAL_TOKEN=replace-with-a-long-random-value
# Set demo only for local development/tests; also set CONTROL_TOWER_ALLOW_DEMO_AUTH=true.
CONTROL_TOWER_AUTH_MODE=jwt
CONTROL_TOWER_ALLOW_DEMO_AUTH=false
CONTROL_TOWER_DEMO_TOKEN=local-only-random-token
CONTROL_TOWER_DEMO_USER=viewer@example.com
CONTROL_TOWER_DEMO_ROLE=viewer
CONTROL_TOWER_DEMO_SCOPES=*
CONTROL_TOWER_JWT_SECRET=replace-with-a-key-from-secret-manager
CONTROL_TOWER_JWT_ISSUER=https://identity.example.com/
CONTROL_TOWER_JWT_AUDIENCE=control-tower-facade

# Boomi credentials stay server-side. Do not expose them to browser code.
BOOMI_ACCOUNT_ID=solutionsteam-70I6P5
BOOMI_USERNAME=service-user@example.com
BOOMI_API_TOKEN=replace-me
BOOMI_API_URL=https://api.boomi.com
ACT_GRAPHQL_URL=https://platform.boomi.com/graphql
ACT_METRICS_HOST=https://agentcontroltower.boomi.com
ACT_ORIGIN=https://control-tower.example.com
# Enable only after rotating BOOMI_API_TOKEN; sync is pull-only.
CONTROL_TOWER_ACT_SYNC=false
